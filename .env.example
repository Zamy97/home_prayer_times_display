# Optional: used only when free Open-Meteo fails (keeps temp on screen without paying for every call)
OPENWEATHER_API_KEY=

# openmeteo (default: free first, OWM fallback) | openweather (OWM only)
# WEATHER_PROVIDER=openmeteo

# CDN cache TTL in seconds (default 600 = 10 min; keep ≤ client refresh interval)
# WEATHER_CACHE_SECONDS=600
